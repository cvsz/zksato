# Production environment configuration for zksato.zeaz.dev
# Deploy this file securely to the server as .env.production

# Core runtime
ZKSATO_ENVIRONMENT=production
ZKSATO_TRADING_MODE=paper
ZKSATO_AUTOMATION_ENABLED=true
ZKSATO_DASHBOARD_ENABLED=true
ZKSATO_INITIAL_CASH=500000
ZKSATO_POLL_INTERVAL_SECONDS=2

# Paper execution simulator
ZKSATO_PAPER_MATCH_RESTING_LIMITS=true
ZKSATO_PAPER_MAX_FILL_QUANTITY_PER_QUOTE=0
ZKSATO_PAPER_PRICE_IMPROVEMENT=true

# Durable state and coordination
ZKSATO_COORDINATION_LOCK_TTL_SECONDS=30
ZKSATO_RECONCILIATION_ENABLED=true
ZKSATO_RECONCILIATION_INTERVAL_SECONDS=15
ZKSATO_METRICS_ENABLED=true

# Authentication/RBAC - ENABLED FOR PRODUCTION
ZKSATO_AUTH_REQUIRED=true
ZKSATO_SESSION_COOKIE_NAME=zksato_session
ZKSATO_SESSION_TTL_SECONDS=1800
ZKSATO_CSRF_REQUIRED=true
ZKSATO_RATE_LIMIT_PER_MINUTE=600
ZKSATO_SECRET_DIR=/run/secrets

# Live trading remains OFF by default. Autonomous live trading is forbidden.
ZKSATO_LIVE_TRADING_ENABLED=false
ZKSATO_LIVE_REQUIRES_CONFIRMATION=true
ZKSATO_LIVE_APPROVAL_TTL_SECONDS=120
ZKSATO_REQUIRE_DISTINCT_APPROVER=true
ZKSATO_LEGACY_LIVE_TOKEN_ENABLED=false

# Trusted market/reference policy
ZKSATO_MARKET_DATA_STALE_SECONDS=10
ZKSATO_MARKET_TIMEZONE=Asia/Bangkok
ZKSATO_EQUITY_SESSIONS=09:30-12:30,14:00-16:30
ZKSATO_ENFORCE_MARKET_SESSIONS=false
ZKSATO_STRICT_REFERENCE_DATA=false

# Equity risk policy
ZKSATO_KILL_SWITCH=false
ZKSATO_MAX_POSITIONS=5
ZKSATO_MAX_POSITION_PCT=10
ZKSATO_MAX_RISK_PER_TRADE_PCT=0.5
ZKSATO_MAX_DAILY_LOSS_PCT=2
ZKSATO_MAX_DRAWDOWN_PCT=5
ZKSATO_MAX_ORDERS_PER_DAY=50
ZKSATO_MAX_OPEN_ORDERS=20
ZKSATO_MAX_NOTIONAL_PER_ORDER=100000
ZKSATO_MAX_PRICE_DEVIATION_PCT=10
ZKSATO_MAX_GROSS_EXPOSURE_PCT=80
ZKSATO_MAX_NET_EXPOSURE_PCT=80
ZKSATO_MAX_SYMBOL_EXPOSURE_PCT=20
ZKSATO_MAX_SECTOR_EXPOSURE_PCT=35
ZKSATO_MAX_SPREAD_PCT=3
ZKSATO_MAX_CONSECUTIVE_BROKER_ERRORS=5
ZKSATO_REQUIRE_STOP_LOSS=true
ZKSATO_ALLOW_EQUITY_SHORT_SELLING=false
ZKSATO_VWAP_PERIOD=14
ZKSATO_SCALP_FAST_PERIOD=3
ZKSATO_SCALP_SLOW_PERIOD=8
ZKSATO_SWING_RSI_PERIOD=14
ZKSATO_POSITION_FAST_PERIOD=50
ZKSATO_POSITION_SLOW_PERIOD=200
ZKSATO_MAX_CORRELATION=0.7
ZKSATO_MAX_ALLOCATION_PCT=20
ZKSATO_RISK_FREE_RATE=0.02

# TFEX risk/reference policy
ZKSATO_MAX_TFEX_CONTRACTS=20
ZKSATO_MAX_TFEX_MARGIN_USAGE_PCT=50
ZKSATO_TFEX_EXPIRY_RESTRICTION_DAYS=2
ZKSATO_STRICT_TFEX_REFERENCE_DATA=false

# Strategy/research policy
ZKSATO_DEFAULT_STRATEGY=ema_cross
ZKSATO_DEFAULT_ORDER_SIZE=100
ZKSATO_DEFAULT_STOP_LOSS_PCT=2
ZKSATO_DEFAULT_TAKE_PROFIT_PCT=4
ZKSATO_DEFAULT_WATCHLIST=AOT,PTT,CPALL,KBANK,ADVANC
ZKSATO_RESEARCH_MIN_TRADES=20
ZKSATO_RESEARCH_MAX_DRAWDOWN_PCT=20
ZKSATO_RESEARCH_MIN_OOS_RETURN_PCT=-100

# Settrade Open API v2
ZKSATO_SETTRADE_APP_CODE=ALGO_EQ

# Observability/SLOs
ZKSATO_LOG_LEVEL=INFO
ZKSATO_LOG_JSON=true
ZKSATO_OTEL_SERVICE_NAME=zksato
ZKSATO_SLO_FEED_FRESHNESS_SECONDS=5
ZKSATO_SLO_RECONCILIATION_BACKLOG_MAX=0
ZKSATO_SLO_API_P95_MS=500

# Notification webhook (optional)
ZKSATO_NOTIFICATION_DISPATCH_INTERVAL_SECONDS=2
ZKSATO_NOTIFICATION_TIMEOUT_SECONDS=5
ZKSATO_NOTIFICATION_BATCH_SIZE=50
ZKSATO_NOTIFICATION_RETRY_BASE_SECONDS=5
ZKSATO_NOTIFICATION_RETRY_MAX_SECONDS=300
ZKSATO_NOTIFICATION_MAX_ATTEMPTS=5

# CCXT & Crypto Spot Integration
ZKSATO_CCXT_ENABLED=false
ZKSATO_CCXT_EXCHANGES=binance,binanceth
ZKSATO_CCXT_SANDBOX=true

# Prediction Markets & CPMM Liquidity Pool
ZKSATO_PREDICTION_ENABLED=false
ZKSATO_PREDICTION_VENUE=polymarket
ZKSATO_PREDICTION_MAX_ORDER_USD=500.0
ZKSATO_PREDICTION_MAX_DIRECTIONAL_RESIDUAL=0.60
ZKSATO_PREDICTION_MAX_COMPLETE_SET_COST=1.05
ZKSATO_PREDICTION_MIN_EDGE=0.02
ZKSATO_PREDICTION_MAX_SLIPPAGE_BPS=250
ZKSATO_PREDICTION_ENABLE_LIVE=false
ZKSATO_PREDICTION_CLOB_URL=https://clob.polymarket.com
ZKSATO_PREDICTION_CLOB_TIMEOUT_SECONDS=10
ZKSATO_MAX_DIRECTIONAL_RESIDUAL=100.0
ZKSATO_MAX_COMPLETE_SET_COST=1.0
ZKSATO_MIN_PREDICTION_EDGE=0.03

# TradingView Webhook & Telegram Alerts
ZKSATO_TELEGRAM_ENABLED=false
ZKSATO_TELEGRAM_NOTIFY_ORDERS=true
ZKSATO_TELEGRAM_NOTIFY_FILLS=true
ZKSATO_TELEGRAM_NOTIFY_KILL_SWITCH=true
ZKSATO_TELEGRAM_NOTIFY_RISK_REJECTIONS=true
ZKSATO_TELEGRAM_NOTIFY_PNL=true
ZKSATO_TELEGRAM_NOTIFY_VAR=true
ZKSATO_TELEGRAM_NOTIFY_TRADINGVIEW=true
ZKSATO_TELEGRAM_NOTIFY_RECONCILIATION=true

# Host Ingress & Allowed Origins
ZKSATO_ALLOWED_ORIGINS=https://zksato.zeaz.dev,https://zksato-api.zeaz.dev
ZKSATO_ALLOWED_HOSTS=zksato.zeaz.dev,zksato-api.zeaz.dev,zksato-dash.zeaz.dev,localhost,127.0.0.1

# Frontend
NEXT_PUBLIC_BACKEND_URL=https://zksato.zeaz.dev

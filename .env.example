# Core runtime
ZKSATO_ENVIRONMENT=dev
ZKSATO_TRADING_MODE=paper
ZKSATO_AUTOMATION_ENABLED=true
ZKSATO_DASHBOARD_ENABLED=true
ZKSATO_INITIAL_CASH=500000
ZKSATO_POLL_INTERVAL_SECONDS=2

# Live trading remains off by default. If deliberately enabled, dashboard/manual
# live orders must also include the matching confirmation token. The bot itself
# cannot place autonomous live orders.
ZKSATO_LIVE_TRADING_ENABLED=false
ZKSATO_LIVE_REQUIRES_CONFIRMATION=true
# ZKSATO_LIVE_CONFIRMATION_TOKEN=replace-with-a-long-random-secret

# Risk policy
ZKSATO_KILL_SWITCH=false
ZKSATO_MAX_POSITIONS=5
ZKSATO_MAX_POSITION_PCT=10
ZKSATO_MAX_RISK_PER_TRADE_PCT=0.5
ZKSATO_MAX_DAILY_LOSS_PCT=2
ZKSATO_MAX_DRAWDOWN_PCT=5
ZKSATO_MAX_ORDERS_PER_DAY=50
ZKSATO_MAX_NOTIONAL_PER_ORDER=100000
ZKSATO_MAX_PRICE_DEVIATION_PCT=10
ZKSATO_REQUIRE_STOP_LOSS=true

# Automation defaults
ZKSATO_DEFAULT_STRATEGY=ema_cross
ZKSATO_DEFAULT_ORDER_SIZE=100
ZKSATO_DEFAULT_STOP_LOSS_PCT=2
ZKSATO_DEFAULT_TAKE_PROFIT_PCT=4
ZKSATO_DEFAULT_WATCHLIST=AOT,PTT,CPALL,KBANK,ADVANC

# Settrade Open API v2. Install with: pip install -e '.[settrade]'
# Keep all credentials server-side and never commit real values.
# Configure settradesdkv2_config.txt with environment=uat for sandbox or
# environment=prod for production as required by the Settrade SDK.
# ZKSATO_SETTRADE_APP_ID=
# ZKSATO_SETTRADE_APP_SECRET=
# ZKSATO_SETTRADE_BROKER_ID=
ZKSATO_SETTRADE_APP_CODE=ALGO_EQ
# ZKSATO_SETTRADE_ACCOUNT_NO=
# ZKSATO_SETTRADE_PIN=

# Generic notification webhook (optional)
# ZKSATO_NOTIFICATION_WEBHOOK_URL=https://example.invalid/webhook
